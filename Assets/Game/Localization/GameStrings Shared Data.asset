      m_Items: []
  - m_Id: 1088438436
    m_Key: Twin Flame
    m_Metadata:
      m_Items: []
  - m_Id: 1088438437
    m_Key: Two embers braided into one. Each beam multiplies.
    m_Metadata:
      m_Items: []
  - m_Id: 1088438438
    m_Key: Tidewarden Scale
    m_Metadata:
      m_Items: []
  - m_Id: 1088438439
    m_Key: A scale plucked from the sea-keeper. Stitches a wound for every three
