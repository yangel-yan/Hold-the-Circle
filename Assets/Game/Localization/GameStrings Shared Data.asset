    m_Metadata:
      m_Items: []
  - m_Id: 1088438442
    m_Key: Sundering Fist
    m_Metadata:
      m_Items: []
  - m_Id: 1088438443
    m_Key: A gauntlet that breaks every world it strikes. A sharp jolt of damage
