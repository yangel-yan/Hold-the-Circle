    m_Metadata:
      m_Items: []
  - m_Id: 1088438364
    m_Localized: Your rite evolves after each cleared encounter.
    m_Metadata:
      m_Items: []
  - m_Id: 1088438365
    m_Localized: THE LANTERN KEEPER
    m_Metadata:
      m_Items: []
  - m_Id: 1088438366
    m_Localized: You carry {0} shards. Confirm a purchase, removal, or departure.
    m_Metadata:
      m_Items: []
  - m_Id: 1088438367
    m_Localized: No relic owned
    m_Metadata:
      m_Items: []
  - m_Id: 1088438368
