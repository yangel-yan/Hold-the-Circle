    m_Metadata:
      m_Items: []
  - m_Id: 1088438272
    m_Localized: Right hand slashes; left hand chains. Hold both hands together at
      your chest to pause.  {0} runs completed.
    m_Metadata:
      m_Items: []
  - m_Id: 1088438273
