.rite-hud {
    padding: 16px 22px;
    color: rgb(227, 235, 235);
    background-color: rgba(9, 18, 30, 0.72);
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: rgba(169, 190, 203, 0.45);
    border-radius: 5px;
}
.rite-hud__headline {
    flex-direction: row;
    align-items: center;
    margin-bottom: 13px;
}
.rite-hud__score {
    font-size: 42px;
    -unity-font-style: bold;
    color: rgb(242, 211, 153);
    width: 160px;
}
.rite-hud__minor { font-size: 23px; color: rgb(175, 195, 212); margin-right: 18px; }
.rite-hud__wave { font-size: 23px; color: rgb(229, 235, 235); flex-grow: 1; }
.rite-hud__combo {
    font-size: 28px;
    -unity-font-style: bold;
    color: rgb(242, 211, 153);
    width: 110px;
    -unity-text-align: middle-right;
}
.rite-hud__meters { flex-direction: row; }
.rite-hud__meter { flex-grow: 1; flex-basis: 0; margin: 0 10px; }
.rite-hud__meter-heading { flex-direction: row; align-items: center; margin-bottom: 7px; }
.rite-hud__icon { width: 28px; height: 32px; margin-right: 7px; }
.rite-hud__meter-title { font-size: 24px; flex-grow: 1; }
.rite-hud__meter-value { font-size: 24px; -unity-font-style: bold; }
.rite-hud__track { height: 5px; background-color: rgba(112, 138, 159, 0.24); }
.rite-hud__fill { height: 5px; width: 100%; }
.rite-hud__warning {
    font-size: 22px;
    color: rgb(246, 151, 104);
    -unity-text-align: middle-center;
    margin-top: 12px;
}
.rite-hud__boss-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: rgb(237, 211, 163);
    flex-grow: 1;
    letter-spacing: 2px;
}
.rite-hud__phase { font-size: 23px; color: rgb(172, 199, 225); }
