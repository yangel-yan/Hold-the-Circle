.world-menu {
    width: 960px;
    height: 720px;
    padding: 34px 40px;
    background-color: rgba(9, 17, 29, 0.92);
    color: rgb(235, 230, 212);
    border-top-width: 2px;
    border-bottom-width: 2px;
    border-top-color: rgb(190, 142, 70);
    border-bottom-color: rgb(190, 142, 70);
    border-radius: 7px;
}
.world-menu__crest { position: absolute; right: 30px; top: 22px; width: 78px; height: 100px; opacity: 0.7; }
#eyebrow {
    color: rgb(203, 161, 95);
    font-size: 16px;
    letter-spacing: 4px;
    margin-bottom: 12px;
}
.world-menu__title { font-size: 43px; -unity-font-style: bold; margin-bottom: 10px; margin-right: 68px; }
.world-menu__description { font-size: 21px; color: rgb(169, 185, 195); white-space: normal; margin-bottom: 24px; }
.world-menu__choices { flex-direction: row; flex-grow: 1; }
.world-menu__choice {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 6px;
    padding: 16px 12px;
    color: rgb(223, 226, 215);
    background-color: rgba(23, 38, 55, 0.96);
    border-width: 1px;
    border-color: rgb(69, 89, 100);
    border-radius: 4px;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    white-space: normal;
    -unity-text-align: middle-center;
}
.world-menu__choice-number {
    position: absolute;
    top: 10px;
    right: 12px;
    font-size: 16px;
    color: rgb(134, 159, 178);
}
.world-menu__choice-icon { width: 64px; height: 64px; flex-shrink: 0; margin-bottom: 6px; }
.world-menu__choice-title {
    font-size: 24px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    white-space: normal;
    flex-shrink: 0;
}
.world-menu__choice-detail {
    font-size: 19px;
    color: rgb(162, 183, 203);
    -unity-text-align: upper-center;
    white-space: normal;
    margin-top: 12px;
}
.world-menu__choice:hover { border-color: rgb(163, 195, 211); background-color: rgb(41, 63, 77); }
.world-menu__choice--ray-hover { border-color: rgb(239, 200, 122); background-color: rgb(41, 63, 77); }
.world-menu__choice--selected { border-width: 3px; border-color: rgb(229, 177, 91); background-color: rgb(45, 47, 43); }
.world-menu__choice:disabled { opacity: 0.4; }
.world-menu__selection { font-size: 21px; -unity-text-align: middle-center; margin-top: 20px; margin-bottom: 12px; color: rgb(236, 191, 117); }
.world-menu__confirm {
    height: 62px;
    width: 310px;
    align-self: center;
    background-color: rgb(181, 131, 58);
    color: rgb(16, 22, 27);
    font-size: 25px;
    -unity-font-style: bold;
    border-width: 0;
    border-radius: 6px;
}
.world-menu__confirm--ray-hover { background-color: rgb(239, 192, 105); }
.world-menu__confirm:disabled { opacity: 0.3; }
.world-menu__hint { font-size: 16px; -unity-text-align: middle-center; margin-top: 10px; color: rgb(146, 161, 170); }
.locale-zh .world-menu__title,
.locale-zh .world-menu__choice-title,
.locale-zh .world-menu__confirm { -unity-font-style: normal; }
.locale-zh #eyebrow { letter-spacing: 1px; }
