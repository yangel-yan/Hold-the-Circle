/* 整个 Icon Configurator 窗口根容器：控制主轴、整体内边距和全局底色。 */
.icon-configurator {
    flex-direction: column;
    flex-grow: 1; /* 让窗口内容占满可用高度。 */
    padding: 12px; /* 整个工具窗口四周的统一留白。 */
    background-color: rgb(30, 30, 30); /* 整个窗口的深色背景。 */
    color: rgb(230, 230, 230); /* 默认文字颜色。 */
}

/* 顶部 Header 区：承载标题和模式切换按钮所在区域。 */
.icon-configurator__header {
    flex-shrink: 0; /* 窗口压缩时不优先挤压 Header。 */
    margin-bottom: 12px; /* 与下方主体内容的间距。 */
}

/* Header 内部单行容器：左侧标题、右侧模式按钮两端分布。 */
.icon-configurator__header-row {
    flex-direction: row;
    justify-content: space-between; /* 标题靠左，模式按钮靠右。 */
    align-items: center; /* 标题与按钮在垂直方向对齐。 */
    gap: 16px; /* 标题和按钮之间的最小间距。 */
}

/* 顶部主标题：Icon Configurator 文本。 */
.icon-configurator__title {
    font-size: 18px; /* 标题字号。 */
    -unity-font-style: bold; /* 标题加粗。 */
    flex-grow: 1; /* 让标题占满左侧，把按钮推到右边。 */
}

/* 模式切换宿主行：承载 Manual / AI Split 两个按钮。 */
.icon-configurator__mode-host {
    flex-direction: row;
    align-items: center; /* 按钮在垂直方向居中。 */
    justify-content: flex-end; /* 模式按钮整体靠右对齐。 */
    gap: 8px; /* 模式切换控件之间的横向间距。 */
    min-height: 32px; /* 避免按钮被压得过矮。 */
    overflow: visible; /* 避免按钮文字或描边被裁切。 */
}

/* 模式切换分段控件本体：让两颗按钮横向排列。 */
.icon-configurator__mode-segment {
    flex-direction: row;
    align-items: center; /* 分段控件内部垂直居中。 */
    min-height: 28px; /* 保证分段控件本身有最小高度。 */
    overflow: visible; /* 避免选中态或文字被裁切。 */
}

/* 主体滚动区：Layers / Preview / Localization 所在内容体。 */
.icon-configurator__body {
    flex-grow: 1; /* 占据 Header 和底栏之间的剩余空间。 */
    flex-shrink: 1; /* 窗口变小时允许主体区先收缩。 */
    min-height: 0; /* 允许 ScrollView 正常收缩，而不是把底栏顶出去。 */
    margin-bottom: 12px; /* 与底部状态栏留出间距。 */
}

/* Shared ScrollView content sizing: Manual and AI Split reuse one global stretch model. */
.icon-configurator__body-content {
    flex-grow: 1;
    min-height: 0;
}

/* 通用 Section 卡片：Layers / Preview / Localization 的外层壳。 */
.icon-configurator__section {
    margin-bottom: 12px; /* 各 Section 卡片之间的竖向间距。 */
    padding: 10px; /* Section 内部四周留白。 */
    border-radius: 4px; /* Section 外层轻微圆角。 */
    background-color: rgb(40, 40, 40); /* Section 外壳底色。 */
    flex-shrink: 0;
}

/* Preview owns the flexible part of the page so window resize applies globally. */
.icon-configurator__section--preview {
    flex-grow: 1;
    min-height: 0;
}

/* 通用 Section 标题：如 Preview / Layers / Localization。 */
.icon-configurator__section-title {
    margin-bottom: 8px; /* 与 Section 内容之间的间距。 */
    -unity-font-style: bold; /* 标题加粗。 */
}

/* 通用 Section 内容区：Section 内部控件之间的间距容器。 */
.icon-configurator__section-content {
    gap: 8px; /* Section 内各行/块的统一间距。 */
}

/* Preview content must stretch with its section instead of keeping per-mode local height. */
.icon-configurator__section-content--preview {
    flex-grow: 1;
    min-height: 0;
}

/* Preview 双列网格：2D Feedback 和 3D Spatial 并排的容器。 */
.icon-configurator__preview-grid {
    flex-direction: row;
    flex-grow: 1; /* 让 Preview 区尽量吃满可用高度。 */
    align-items: stretch; /* 两张卡片在竖向上保持等高拉伸。 */
    min-width: 0; /* 避免子元素把双列宽度撑爆。 */
    column-gap: 12px; /* 2D 和 3D 卡片之间的横向留白。 */
}

/* Preview 单张卡片外壳：2D 卡片和 3D 卡片共享。 */
.icon-configurator__preview-card {
    flex-grow: 1; /* 两张卡片平均分配宽度。 */
    flex-basis: 0; /* 配合 flex-grow 保证缩放时尽量等宽。 */
    min-width: 0; /* 避免内容撑开卡片宽度。 */
    padding: 6px; /* 卡片外壳与内部画布之间的留白。 */
    border-radius: 6px; /* 卡片外层轻微圆角。 */
    background-color: rgb(52, 52, 56); /* 卡片壳层底色。 */
    justify-content: flex-start; /* 内容从顶部开始排布。 */
}

/* 3D 卡片额外样式：目前主要保留与普通卡片一致的顶部对齐。 */
.icon-configurator__preview-card--spatial {
    justify-content: flex-start; /* 3D 卡片内容也从顶部开始排布。 */
    padding: 6px; /* 保持与 2D 卡片一致的外层内边距。 */
}

/* Preview Shell：每张预览卡片内部真正承载画布和叠层元素的相对定位容器。 */
.icon-configurator__preview-shell {
    position: relative; /* 让标题和 3D 底部悬浮条能相对画布绝对定位。 */
    flex-grow: 1; /* Shell 占满整张预览卡片内部剩余区域。 */
}

/* 3D Preview Shell：单独预留扩展点，目前仅保持占满。 */
.icon-configurator__preview-shell--spatial {
    flex-grow: 1; /* 让 3D 预览壳层占满 3D 卡片。 */
}

/* 悬浮标题标签基础样式：2D Feedback / 3D Spatial 都复用这里的视觉。 */
.icon-configurator__preview-card-title {
    margin-bottom: 8px; /* 非悬浮场景下的默认下边距，当前主要保底。 */
    padding-top: 2px; /* 标签上下内边距。 */
    padding-bottom: 2px; /* 标签上下内边距。 */
    padding-left: 6px; /* 标签左右内边距。 */
    padding-right: 6px; /* 标签左右内边距。 */
    border-radius: 4px; /* 标签本身的小圆角。 */
    background-color: rgba(80, 82, 88, 1); /* 标签底色。 */
    color: rgb(245, 245, 245); /* 标签文字颜色。 */
    -unity-font-style: bold; /* 标签文字加粗。 */
    max-width: 90px; /* 限制标签宽度，避免过长影响观感。 */
}

/* 悬浮标题定位：把 2D / 3D 标题压到各自画布左上角内部。 */
.icon-configurator__preview-card-title--overlay {
    position: absolute; /* 改成悬浮定位，不再占据正常文档流。 */
    top: 8px; /* 距离画布顶部的偏移。 */
    left: 8px; /* 距离画布左侧的偏移。 */
    margin-bottom: 0; /* 悬浮时不再需要普通流里的下边距。 */
}

/* Preview 画布容器：控制预览主体区域的最小高度。 */
.icon-configurator__preview-canvas {
    flex-grow: 1; /* 让画布尽量占满卡片高度。 */
    min-height: 160px; /* 预览区最小高度，避免过度压缩。 */
}

/* 预览显示底板：2D / 3D 真正看到的那块浅灰画布。 */
.icon-configurator__preview-surface {
    flex-grow: 1; /* 占满画布容器。 */
    border-radius: 4px; /* 画布自身的小圆角。 */
    background-color: rgba(117, 119, 125, 1); /* 2D / 3D 预览底板颜色。 */
}

/* 预览视口：负责把图片内容在画布里居中摆放并裁掉超出部分。 */
.icon-configurator__preview-viewport {
    flex-grow: 1; /* 让视口占满整个底板。 */
    justify-content: center; /* 图片在水平方向居中。 */
    align-items: center; /* 图片在垂直方向居中。 */
    overflow: hidden; /* 超出视口的内容隐藏。 */
}

/* 2D 专用棋盘格底：只作用在 2D Feedback 画布，模拟透明背景检查板。 */
.icon-configurator__preview-surface--checkerboard {
    background-color: rgb(122, 122, 128); /* 棋盘格的底色。 */
    background-image:
        linear-gradient(45deg, rgb(104, 104, 110) 25%, transparent 25%),
        linear-gradient(-45deg, rgb(104, 104, 110) 25%, transparent 25%),
        linear-gradient(45deg, transparent 75%, rgb(104, 104, 110) 75%),
        linear-gradient(-45deg, transparent 75%, rgb(104, 104, 110) 75%); /* 组合出棋盘格纹理。 */
    background-size: 16px 16px; /* 棋盘格单元尺寸。 */
    background-position: 0 0, 0 8px, 8px -8px, -8px 0; /* 交错对齐四层纹理。 */
}

/* 预览图片本体：2D 合成图和 3D RenderTexture 都走这里。 */
.icon-configurator__preview-image {
    max-width: 100%; /* 图片宽度不超过画布。 */
    max-height: 100%; /* 图片高度不超过画布。 */
    unity-background-scale-mode: scale-to-fit; /* 保持比例缩放到可见区域内。 */
}

/* 3D 底部控制条内部一行：Y、滑杆、角度值的横向排布。 */
.icon-configurator__preview-slider-row {
    flex-direction: row;
    justify-content: space-between; /* 三段内容两端对齐展开。 */
    align-items: center; /* 在竖向上居中对齐。 */
}

/* 预览控制条基础样式：普通底部控制容器的保底样式。 */
.icon-configurator__preview-controls {
    min-height: 32px; /* 控制条基础最小高度。 */
    padding-left: 8px; /* 控制条左右内边距。 */
    padding-right: 8px; /* 控制条左右内边距。 */
    background-color: rgba(48, 64, 153, 0.8); /* 基础控制条底色。 */
    justify-content: center; /* 内部内容竖向居中。 */
}

/* 3D 悬浮层定位：把底部控制条贴到 3D 画布内部底边。 */
.icon-configurator__preview-overlay {
    position: absolute; /* 相对 3D shell 绝对定位。 */
    left: 0; /* 贴齐画布左边。 */
    right: 0; /* 贴齐画布右边。 */
    bottom: 0; /* 贴齐画布底边。 */
}

/* 3D 底部悬浮控制条外观：当前看到的浅灰底条就是这里。 */
.icon-configurator__preview-controls--overlay {
    min-height: 24px; /* 贴边底条的实际可见高度。 */
    border-top-left-radius: 4px; /* 顶部左角轻微圆角。 */
    border-top-right-radius: 4px; /* 顶部右角轻微圆角。 */
    border-bottom-left-radius: 0; /* 底边贴画布，不保留圆角。 */
    border-bottom-right-radius: 0; /* 底边贴画布，不保留圆角。 */
    background-color: rgba(87, 86, 86, 0.9); /* 3D 底部悬浮条底色。 */
}

/* 3D 控制条左侧 Y 轴标签。 */
.icon-configurator__preview-slider-axis {
    min-width: 14px; /* 给 Y 标签一个稳定宽度。 */
    flex-shrink: 0; /* 不被压缩，避免挤占滑杆与角度值导致内容溢出。 */
    color: rgb(236, 236, 236); /* Y 标签文字颜色。 */
}

/* 3D 滑杆主体：中间可拖动的角度控制条。 */
.icon-configurator__preview-slider {
    flex-grow: 1; /* 占满 Y 和角度值之间的剩余空间。 */
    flex-shrink: 1; /* 空间不足时由滑杆收缩，而非两侧标签。 */
    margin-left: 8px; /* 与左侧 Y 标签的间距。 */
    margin-right: 8px; /* 与右侧角度值的间距。 */
}

/* 3D 控制条右侧角度值文本。 */
.icon-configurator__preview-slider-value {
    min-width: 36px; /* 预留宽度容纳负角度（如 -80°），避免文字溢出控制条右边缘。 */
    flex-shrink: 0; /* 不被压缩，保证负角度文字完整且不溢出。 */
    color: rgb(236, 236, 236); /* 角度值文字颜色。 */
    -unity-text-align: middle-right; /* 数值靠右对齐。 */
}

/* 3D 滑杆轨道：白色半透明线条。 */
.icon-configurator__preview-controls--overlay .unity-base-slider__tracker {
    background-color: rgba(255, 255, 255, 0.35); /* 滑杆轨道颜色。 */
    border-width: 0; /* 去掉默认 1px 边框，避免圆角边框在两端绕行收窄成尖角。 */
    border-radius: 0; /* 取消胶囊圆角，让线条从头到尾宽度一致。 */
    height: 3px; /* 滑杆轨道粗细。 */
}

.icon-configurator__preview-controls--overlay .unity-base-slider__tracker-dragger {
    background-color: rgba(255, 255, 255, 0.35); /* 滑杆轨道颜色。 */
    border-width: 0; /* 去掉默认 1px 边框，避免圆角边框在两端绕行收窄成尖角。 */
    border-radius: 0; /* 取消胶囊圆角，让线条从头到尾宽度一致。 */
    height: 3px; /* 滑杆轨道粗细。 */
}

.icon-configurator__preview-controls--overlay .unity-base-slider__tracker-highlight {
    background-color: rgba(255, 255, 255, 0.35); /* 滑杆轨道颜色。 */
    border-width: 0; /* 去掉默认 1px 边框，避免圆角边框在两端绕行收窄成尖角。 */
    border-radius: 0; /* 取消胶囊圆角，让线条从头到尾宽度一致。 */
    height: 3px; /* 滑杆轨道粗细。 */
}

/* 3D 滑杆圆点：中间那颗可拖动的白色按钮。 */
.icon-configurator__preview-controls--overlay .unity-base-slider__dragger {
    background-color: rgb(248, 248, 248); /* 滑杆圆点颜色。 */
    border-radius: 999px; /* 圆点做成圆形。 */
    width: 10px; /* 圆点宽度与轨道粗细匹配。 */
    height: 10px; /* 圆点高度与轨道粗细匹配。 */
}

/* 窗口底栏：底部状态文字和 Apply 按钮所在区域。 */
.icon-configurator__bottom-bar {
    flex-direction: row;
    flex-shrink: 0; /* 窗口缩小时不优先压缩底栏。 */
    justify-content: space-between; /* 左侧状态和右侧按钮两端分布。 */
    align-items: center; /* 底栏控件垂直居中。 */
    padding-top: 8px; /* 底栏顶部留白。 */
    border-top-width: 1px; /* 底栏上分割线粗细。 */
    border-top-color: rgb(55, 55, 55); /* 底栏上分割线颜色。 */
}

/* 底栏左侧状态文案。 */
.icon-configurator__bottom-status {
    color: rgb(180, 180, 180); /* 状态文案的弱化颜色。 */
}

/* Apply 按钮：底栏右下角主操作按钮。 */
.icon-configurator__apply-button {
    min-width: 120px; /* 按钮最小宽度。 */
    min-height: 24px; /* 按钮最小高度。 */
    -unity-text-align: middle-center; /* 按钮文字居中。 */
}

/* Mode 按钮：顶部 Manual / AI Split 两个模式按钮。 */
.icon-configurator__mode-button {
    min-width: 120px; /* 顶部模式按钮最小宽度。 */
    min-height: 24px; /* 顶部模式按钮最小高度。 */
    -unity-text-align: middle-center; /* 模式按钮文字居中。 */
    padding-top: 2px; /* 顶部模式按钮上下内边距。 */
    padding-bottom: 2px; /* 顶部模式按钮上下内边距。 */
}

/* 选中的模式按钮：如当前选中 Manual 时的高亮底色。 */
.icon-configurator__mode-button--selected {
    background-color: rgb(55, 110, 190); /* 模式按钮选中态背景。 */
}

/* 占位提示文案：没有内容时使用的弱提示文本。 */
.icon-configurator__placeholder {
    color: rgb(155, 155, 155); /* 占位文字颜色。 */
}

/* AI Split 同意区域：勾选框 + 下方说明文案块整体作为一个同意面板。 */
.icon-configurator__agreement {
    flex-direction: column;
    margin-top: 4px; /* 与上方进度条留出间距。 */
}

/* 同意勾选框：I agree 复选框本体。勾选框在左、文本在右。 */
.icon-configurator__agreement-toggle {
    flex-direction: row-reverse; /* 反转默认顺序：勾选框移到左侧，文本移到右侧。 */
    justify-content: flex-end; /* row-reverse 下 flex-end 表示整体靠左对齐。 */
    align-items: center; /* 勾选框与文本垂直居中对齐。 */
    margin-bottom: 6px; /* 与下方说明文案块的间距。 */
}

/* 勾选框容器：取消默认撑满，避免勾选框与文本被拉到两端。 */
.icon-configurator__agreement-toggle .unity-toggle__input {
    flex-grow: 0;
}

.icon-configurator__agreement-toggle .unity-label {
    flex-grow: 0; /* 文本不再撑满，紧贴勾选框。 */
    min-width: auto; /* 取消默认最小宽度，避免文本与勾选框被拉开。 */
    margin-left: 6px; /* 文本在右侧时与左侧勾选框留出间距。 */
    -unity-font-style: bold; /* I agree 文本加粗，作为同意标题。 */
    color: rgb(230, 230, 230); /* 与窗口主文字色保持一致。 */
}

/* 勾选框方块：底色改为明显的灰色，与深色面板区分。 */
.icon-configurator__agreement-toggle .unity-toggle__checkmark {
    background-color: rgb(120, 120, 120); /* 勾选框灰色底，比面板亮便于辨识。 */
    border-color: rgb(160, 160, 160); /* 更亮的灰色描边，强化边界。 */
    border-width: 1px;
}

/* 同意说明文案块：浅色圆角底块，承载算法偏差免责声明。 */
.icon-configurator__agreement-disclaimer {
    padding: 12px; /* 文案块四周留白。 */
    border-radius: 6px; /* 圆角块。 */
    background-color: rgb(46, 46, 48); /* 比 Section 略浅的底块色。 */
    color: rgb(196, 196, 196); /* 说明文字弱化颜色。 */
    white-space: normal; /* 允许长文案自动换行。 */
}

.icon-configurator__layer-slot {
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.06);
    border-radius: 4px;
    padding: 6px;
}

.icon-configurator__layer-slot--drag-over {
    border-color: rgb(85, 150, 240);
    background-color: rgba(85, 150, 240, 0.08);
}
